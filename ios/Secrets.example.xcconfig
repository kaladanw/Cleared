// Copy to Secrets.xcconfig and fill in. Secrets.xcconfig is gitignored —
// this repo is public, so the real URL/token must never be committed
// (same pattern as backend/.env.example -> .env.local).
//
// NOTE the $() trick: `//` starts a comment in xcconfig syntax, so a bare
// https:// URL would be truncated. $() expands to nothing at build time.

CLEARED_BACKEND_URL = https:/$()/your-backend.example.com
CLEARED_SHARED_TOKEN = paste-the-railway-CLEARED_SHARED_TOKEN-value
