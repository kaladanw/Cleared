# Copy to .env.local and fill in. The key never ships in the iOS app — it lives here.
ANTHROPIC_API_KEY=sk...
# Model for the check. claude-opus-4-8 (default) or claude-sonnet-4-6 (cheaper).
CLEARED_MODEL=claude-opus-4-8
# Optional: legacy shared secret for the multipart /check endpoint via
# X-Cleared-Token (unsaved, not user-scoped). Requests with
# Authorization: Bearer <jwt> ignore it and save to the user's history.
CLEARED_SHARED_TOKEN=

# CORS allowlist. Leave both unset for wide-open "*" (local dev / no deployed
# extension or site yet). Set CLEARED_EXTENSION_ORIGIN to the chrome-extension://
# URI (visible in chrome://extensions after loading unpacked) to lock down the
# extension origin. Set CLEARED_WEB_ORIGINS to a comma-separated list of
# allowed web origins (e.g. Vercel production + preview domains) once known.
# Either one set (or both) drops the "*" fallback and builds an explicit list.
CLEARED_EXTENSION_ORIGIN=
CLEARED_WEB_ORIGINS=

# Supabase — create a project at https://supabase.com, then copy these from
# project Settings → API. Run backend/supabase/schema.sql in the SQL Editor first.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # "service_role" key (secret — never ship in the app)
# Optional: "anon" public key. When set, user auth calls (login/signup/refresh)
# use it on a throwaway client; otherwise they fall back to the service key.
SUPABASE_ANON_KEY=

# Private Storage bucket for screenshots from authenticated iOS /check
# (create it with migrations/20261008_ios_account_parity.sql). Optional overrides:
CLEARED_IMAGE_BUCKET=check-images
# Per-image upload cap for /check in bytes (default 10 MB; max 8 images).
CLEARED_MAX_IMAGE_BYTES=10485760

# Comma-separated emails allowed to sign up. Leave empty to allow any email (dev mode).
# Set to your own email for a personal single-user deployment.
CLEARED_ALLOWED_EMAILS=you@example.com
