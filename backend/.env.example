# Copy to .env.local and fill in. The key never ships in the iOS app — it lives here.
ANTHROPIC_API_KEY=sk...
# Model for the check. claude-opus-4-8 (default) or claude-sonnet-4-6 (cheaper).
CLEARED_MODEL=claude-opus-4-8
# Optional: require this token on the multipart /check endpoint via X-Cleared-Token.
CLEARED_SHARED_TOKEN=

# Supabase — create a project at https://supabase.com, then copy these from
# project Settings → API. Run backend/supabase/schema.sql in the SQL Editor first.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # "service_role" key (secret — never ship in the app)

# Comma-separated emails allowed to sign up. Leave empty to allow any email (dev mode).
# Set to your own email for a personal single-user deployment.
CLEARED_ALLOWED_EMAILS=you@example.com
